@startuml
!include estilo.puml
!pragma useVerticalIf on
title DepGraph — Atividade de resolução (proposta)
start
:Validar sintaxe, catálogo\ne estado instalado;
if (Entrada e base válidas?) then (não)
    :Informar erro de entrada ou estado;
    stop
else (sim)
    :Acumular pedidos e fixar\ninstalados não solicitados;
    :Inicializar pilha com atribuição vazia\ne contador de tentativas em zero;
endif
while (Há ramo pendente?) is (sim)
    :Retirar o próximo ramo\nda pilha;
    if (Ramo escolhe um candidato?) then (sim)
        if (Limite de tentativas atingido?) then (sim)
            :Retornar resultado\ninconclusivo;
            stop
        else (não)
            :Contar tentativa, selecionar versão\ne incorporar suas dependências\na cópia de requisitos deste ramo;
        endif
    else (não)
    endif
    if (Restrições e conflitos satisfeitos?) then (sim)
        if (Atribuição completa?) then (sim)
            :Construir grafo e executar Kahn;
            if (Ordem completa?) then (sim)
                :Retornar plano válido\ne operações necessárias;
                stop
            else (não)
                :Reconstruir ciclo por DFS\ne registrar diagnóstico;
            endif
        else (não)
            :Consultar candidatos compatíveis\ndo próximo nome;
            if (Há candidatos?) then (sim)
                :Empilhar um ramo independente\npor candidato, para explorar\nprimeiro as versões mais altas;
            else (não)
                :Registrar dependência ausente\nou versão incompatível;
            endif
        endif
    else (não)
        :Registrar restrição incompatível\nou conflito declarado;
    endif
    :Descartar apenas os dados do ramo atual;\npreservar os ramos pendentes;
endwhile (não)
:Retornar bloqueado com\ndiagnóstico representativo;
stop
@enduml
